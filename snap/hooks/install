#!/bin/bash
set -euo pipefail

umask 077
mkdir -p "$SNAP_COMMON/.mlx-serve/models" "$SNAP_COMMON/tmp"
chmod 0700 "$SNAP_COMMON" "$SNAP_COMMON/.mlx-serve" "$SNAP_COMMON/.mlx-serve/models" "$SNAP_COMMON/tmp"

[[ -n "$(snapctl get daemon.enabled)" ]] || snapctl set daemon.enabled=false
[[ -n "$(snapctl get daemon.host)" ]] || snapctl set daemon.host=127.0.0.1
[[ -n "$(snapctl get daemon.port)" ]] || snapctl set daemon.port=11234
